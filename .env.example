###############################################################
# Example environment variables for the diploma project
# Copy this file to `.env` and adjust values for your setup.
###############################################################

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=diploma_db

# App DB config (FastAPI Settings will use these to build DSN)
# Services should use least-privilege role (app_write). Use postgres/app_admin only for bootstrap.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=${POSTGRES_DB}
DB_USER=app_write
DB_PASSWORD=please-change-me-app-write
# Optionally override full DSN (otherwise built from DB_* above)
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# --- API ---
API_TITLE=Intelligent Web Data Aggregator
API_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production
CORS_ORIGINS=*

# --- LLM API Keys / Provider ---
# Supported providers via LiteLLM: gemini, openai (others can be added)
# Gemini (Google AI Studio) keys can be supplied via either GOOGLE_API_KEY or GEMINI_API_KEY.
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=

# --- Worker/Playwright (future) ---
PLAYWRIGHT_HEADLESS=true
