###############################################################
# Example environment variables for the diploma project
# Copy this file to `.env` and adjust values for your setup.
###############################################################

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=diploma_db

# App DB config (FastAPI Settings will use these to build DSN)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
# Optionally override full DSN (otherwise built from DB_* above)
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# --- API ---
API_TITLE=Intelligent Web Data Aggregator
API_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production
CORS_ORIGINS=*

# --- LLM API Keys ---
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo

# --- Worker/Playwright (future) ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
