###############################################################
# Example environment variables for the diploma project
# Copy this file to `.env` and adjust values for your setup.
###############################################################

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres  # superuser used only for admin/bootstrap
POSTGRES_DB=diploma_db

# App DB config (services use least-privilege app_write role)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=${POSTGRES_DB}
DB_USER=app_write
DB_PASSWORD=change-me-app-write-password
# Optionally override full DSN (otherwise built from DB_* above)
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

SQLALCHEMY_MUTE_LOGGING=true
LOG_LEVEL=DEBUG
LLM_LOG_PAYLOADS=true
# --- API ---
API_TITLE=Intelligent Web Data Aggregator
API_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production
CORS_ORIGINS=*

# --- LLM API Keys / Provider ---
# Supported providers via LiteLLM: baseten (DeepSeek), gemini (fallback), openai (if enabled)
# Baseten (DeepSeek) key
BASETEN_API_KEY=replace-with-your-baseten-key
# Gemini (Google AI Studio) keys can be supplied via either GOOGLE_API_KEY or GEMINI_API_KEY.
GOOGLE_API_KEY=replace-with-your-google-api-key
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=baseten
LLM_MODEL=baseten/deepseek-ai/DeepSeek-V3.2
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3-flash-preview
LLM_LARGE_CONTEXT_MODEL=gemini-3-flash-preview
LLM_LARGE_CONTEXT_THRESHOLD=100000
LLM_TEMPERATURE=1
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=125000  # Must be <=262144 for Baseten DeepSeek (clamped in code)

# --- Worker/Playwright (future) ---
PLAYWRIGHT_HEADLESS=true
