    "/api/v1/process": {
      "post": {
        "tags": [
          "API v1"
        ],
        "summary": "Create a scraping task",
        "description": "Accepts a URL and a natural language prompt, creates a background scraping task (initially PENDING), and returns its task_id for status polling.",
        "operationId": "process_request_api_v1_process_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScrapeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Task accepted and created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                },
                "example": {
                  "task_id": "123e4567-e89b-12d3-a456-426614174000",
                  "status": "PENDING",
                  "message": "Task created successfully",
                  "created_at": "2025-08-08T12:00:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Validation error in the request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Bad Request",
                  "message": "Invalid URL format",
                  "timestamp": "2025-08-08T12:00:00Z"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/status/{task_id}": {
      "get": {
        "tags": [
          "API v1"
        ],
        "summary": "Get task status",
        "description": "Check the current status of a previously created task. Returns one of PENDING, IN_PROGRESS, SUCCESS, or FAILED.",
        "operationId": "get_task_status_api_v1_status__task_id__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current task status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskStatusResponse"
                },
                "example": {
                  "task_id": "123e4567-e89b-12d3-a456-426614174000",
                  "status": "IN_PROGRESS",
                  "progress": 40,
                  "created_at": "2025-08-08T12:00:00Z",
                  "updated_at": "2025-08-08T12:00:20Z"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Not Found",
                  "message": "Task not found",
                  "timestamp": "2025-08-08T12:00:00Z"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/result/{task_id}": {
      "get": {
        "tags": [
          "API v1"
        ],
        "summary": "Get final result for a completed task",
        "description": "Retrieve the final extracted data for a task once it has completed successfully.",
        "operationId": "get_task_result_api_v1_result__task_id__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful scraping result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapeResult"
                },
                "example": {
                  "task_id": "123e4567-e89b-12d3-a456-426614174000",
                  "status": "SUCCESS",
                  "url": "https://example-jobs.com",
                  "prompt": "I want all the job listings with their titles and locations",
                  "data": [
                    {
                      "text": "Senior Software Engineer \u2014 Berlin",
                      "source": "//div[@class='job-card']/h2",
                      "confidence": 0.92
                    }
                  ],
                  "metadata": {
                    "total_matches": 1,
                    "used_cached_parser": false
                  },
                  "processing_time": 3.21,
                  "created_at": "2025-08-08T12:00:00Z",
                  "completed_at": "2025-08-08T12:00:03Z"
                }
              }
            }
          },
          "202": {
            "description": "Task not completed yet",
            "content": {
              "application/json": {
                "example": {
                  "task_id": "123e4567-e89b-12d3-a456-426614174000",
                  "status": "IN_PROGRESS",
                  "progress": 75,
                  "created_at": "2025-08-08T12:00:00Z",
                  "updated_at": "2025-08-08T12:00:10Z"
                },
                "schema": {
                  "$ref": "#/components/schemas/TaskStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Task failed",
            "content": {
              "application/json": {
                "example": {
                  "error": "Bad Request",
                  "message": "Task failed: regex did not match",
                  "timestamp": "2025-08-08T12:00:10Z"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Not Found",
                  "message": "Task not found",
                  "timestamp": "2025-08-08T12:00:10Z"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
