  "openapi": "3.1.0",
  "info": {
    "title": "Intelligent Web Data Aggregator",
    "description": "\n    An intelligent service that accepts a URL and a natural language prompt \n    and automatically extracts the requested data using web scraping and \n    Large Language Models (LLMs).\n    \n    ## Features\n    \n    * **Natural Language Processing**: Use plain English to describe what data you want\n    * **Intelligent Extraction**: LLM-powered data identification and extraction\n    * **Regex Generation**: Automatic regular expression creation and validation\n    * **Caching**: Smart caching of successful parsers for future use\n    * **Asynchronous Processing**: Non-blocking task execution with status tracking\n    ",
    "contact": {
      "name": "Yan Marchan",
      "email": "dadada.marchan@gmail.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0"
  },
